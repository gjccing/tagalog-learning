{
  "id": "lesson-8",
  "stage": 1,
  "level": "A0",
  "title": "I Want",
  "goal": "Express what you want and ask what another person wants.",
  "vocabulary": [
    {
      "tagalog": "gusto",
      "english": "want / like"
    },
    {
      "tagalog": "kape",
      "english": "coffee"
    },
    {
      "tagalog": "tubig",
      "english": "water"
    },
    {
      "tagalog": "pagkain",
      "english": "food"
    },
    {
      "tagalog": "kanin",
      "english": "cooked rice"
    },
    {
      "tagalog": "manok",
      "english": "chicken"
    }
  ],
  "patterns": [
    {
      "tagalog": "Gusto ko ng kape.",
      "english": "I want coffee."
    },
    {
      "tagalog": "Gusto ko ng tubig.",
      "english": "I want water."
    },
    {
      "tagalog": "Gusto ko ng pagkain.",
      "english": "I want food."
    },
    {
      "tagalog": "Gusto ko ng kanin.",
      "english": "I want rice."
    },
    {
      "tagalog": "Gusto mo ba ng kape?",
      "english": "Do you want coffee?"
    },
    {
      "tagalog": "Gusto mo ba ng tubig?",
      "english": "Do you want water?"
    }
  ],
  "notes": [],
  "practice": {
    "objectives": [
      {
        "id": "express-want",
        "description": "Say what you want using Gusto ko ng ..."
      },
      {
        "id": "ask-want",
        "description": "Ask another person whether they want something."
      },
      {
        "id": "choose-food-drink",
        "description": "Use food and drink words to make a simple choice."
      }
    ],
    "scenarios": [
      {
        "id": "choose-drink",
        "title": "Choosing a drink",
        "setup": "You and another person are deciding what to drink.",
        "learnerGoal": "Say what you want and ask what the other person wants.",
        "targets": [
          "Gusto ko ng kape.",
          "Gusto ko ng tubig.",
          "Gusto mo ba ng kape?",
          "Gusto mo ba ng tubig?"
        ]
      },
      {
        "id": "choose-food",
        "title": "Choosing food",
        "setup": "You are deciding what to eat.",
        "learnerGoal": "Say that you want food or rice.",
        "targets": [
          "Gusto ko ng pagkain.",
          "Gusto ko ng kanin."
        ]
      }
    ]
  }
}
