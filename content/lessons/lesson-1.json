{
  "id": "lesson-1",
  "stage": 1,
  "level": "A0",
  "title": "Hello and Introductions",
  "goal": "Greet someone, ask their name and where they are from, and give a very simple introduction.",
  "vocabulary": [
    {
      "tagalog": "Kumusta?",
      "english": "How are you? / Hello"
    },
    {
      "tagalog": "ako",
      "english": "I / me"
    },
    {
      "tagalog": "ikaw",
      "english": "you"
    },
    {
      "tagalog": "ka",
      "english": "you (in questions)"
    },
    {
      "tagalog": "pangalan",
      "english": "name"
    },
    {
      "tagalog": "ano",
      "english": "what"
    },
    {
      "tagalog": "mo",
      "english": "your"
    },
    {
      "tagalog": "taga-",
      "english": "from / native of"
    },
    {
      "tagalog": "saan",
      "english": "where"
    },
    {
      "tagalog": "mabuti",
      "english": "good / fine"
    }
  ],
  "patterns": [
    {
      "tagalog": "Kumusta?",
      "english": "How are you? / Hello"
    },
    {
      "tagalog": "Mabuti ako.",
      "english": "I am fine."
    },
    {
      "tagalog": "Ikaw?",
      "english": "How about you?"
    },
    {
      "tagalog": "Ano ang pangalan mo?",
      "english": "What is your name?"
    },
    {
      "tagalog": "Ako si Anna.",
      "english": "I am Anna."
    },
    {
      "tagalog": "Ang pangalan ko ay Anna.",
      "english": "My name is Anna."
    },
    {
      "tagalog": "Taga-saan ka?",
      "english": "Where are you from?"
    },
    {
      "tagalog": "Taga-Taiwan ako.",
      "english": "I am from Taiwan."
    }
  ],
  "notes": [
    "In a question, use ka instead of ikaw, as in Taga-saan ka? Use mo for your, as in Ano ang pangalan mo?"
  ],
  "practice": {
    "objectives": [
      {
        "id": "greet",
        "description": "Greet someone naturally using Kumusta?"
      },
      {
        "id": "ask-name",
        "description": "Ask someone what their name is."
      },
      {
        "id": "introduce-name",
        "description": "Introduce yourself by name."
      },
      {
        "id": "ask-origin",
        "description": "Ask someone where they are from."
      },
      {
        "id": "say-origin",
        "description": "Say where you are from."
      },
      {
        "id": "respond-how-are-you",
        "description": "Give a simple response to Kumusta? and ask the other person back."
      }
    ],
    "scenarios": [
      {
        "id": "first-meeting",
        "title": "Meeting someone for the first time",
        "setup": "You meet a new person in a casual setting.",
        "learnerGoal": "Greet them, ask their name, say your name, ask where they are from, say where you are from, and respond when they ask how you are.",
        "targets": [
          "Kumusta?",
          "Ano ang pangalan mo?",
          "Ako si Anna.",
          "Taga-saan ka?",
          "Taga-Taiwan ako.",
          "Mabuti ako.",
          "Ikaw?"
        ]
      },
      {
        "id": "simple-introduction",
        "title": "Simple self-introduction",
        "setup": "Someone asks who you are.",
        "learnerGoal": "Answer their questions and give a short self-introduction without being shown the full answer first.",
        "targets": [
          "Ano ang pangalan mo?",
          "Ako si Anna.",
          "Ang pangalan ko ay Anna.",
          "Taga-saan ka?",
          "Taga-Taiwan ako."
        ]
      }
    ]
  }
}
