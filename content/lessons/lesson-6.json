{
  "id": "lesson-6",
  "stage": 1,
  "level": "A0",
  "title": "Eating",
  "goal": "Talk about eating and basic food needs.",
  "vocabulary": [
    {
      "tagalog": "kumain",
      "english": "to eat / ate"
    },
    {
      "tagalog": "pagkain",
      "english": "food"
    },
    {
      "tagalog": "kanin",
      "english": "cooked rice"
    },
    {
      "tagalog": "tinapay",
      "english": "bread"
    },
    {
      "tagalog": "itlog",
      "english": "egg"
    },
    {
      "tagalog": "manok",
      "english": "chicken"
    },
    {
      "tagalog": "isda",
      "english": "fish"
    }
  ],
  "patterns": [
    {
      "tagalog": "Kumain ako ng kanin.",
      "english": "I ate rice."
    },
    {
      "tagalog": "Kumain ako ng tinapay.",
      "english": "I ate bread."
    },
    {
      "tagalog": "Kumain ako ng itlog.",
      "english": "I ate an egg."
    },
    {
      "tagalog": "Kumain ako ng manok.",
      "english": "I ate chicken."
    },
    {
      "tagalog": "Kumain ako ng isda.",
      "english": "I ate fish."
    },
    {
      "tagalog": "May pagkain ba?",
      "english": "Is there food?"
    }
  ],
  "notes": [],
  "practice": {
    "objectives": [
      {
        "id": "say-what-ate",
        "description": "Say what you ate using a simple Kumain ako ng ... sentence."
      },
      {
        "id": "use-food-words",
        "description": "Use basic food vocabulary in short sentences."
      },
      {
        "id": "ask-food-available",
        "description": "Ask whether there is food available."
      }
    ],
    "scenarios": [
      {
        "id": "meal-chat",
        "title": "Talking about a meal",
        "setup": "Someone asks what you ate.",
        "learnerGoal": "Answer with one or more foods from this lesson.",
        "targets": [
          "Kumain ako ng kanin.",
          "Kumain ako ng tinapay.",
          "Kumain ako ng itlog.",
          "Kumain ako ng manok.",
          "Kumain ako ng isda."
        ]
      },
      {
        "id": "check-food",
        "title": "Checking for food",
        "setup": "You arrive somewhere and want to know whether food is available.",
        "learnerGoal": "Ask if there is food.",
        "targets": [
          "May pagkain ba?"
        ]
      }
    ]
  }
}
