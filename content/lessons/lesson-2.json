{
  "id": "lesson-2",
  "stage": 1,
  "level": "A0",
  "title": "Yes, No, and Okay",
  "goal": "Respond to simple questions and situations.",
  "vocabulary": [
    {
      "tagalog": "oo",
      "english": "yes"
    },
    {
      "tagalog": "hindi",
      "english": "no / not"
    },
    {
      "tagalog": "sige",
      "english": "okay / sure / go ahead"
    },
    {
      "tagalog": "okay lang",
      "english": "it's okay / I'm okay"
    }
  ],
  "patterns": [
    {
      "tagalog": "Oo.",
      "english": "Yes."
    },
    {
      "tagalog": "Hindi.",
      "english": "No."
    },
    {
      "tagalog": "Sige.",
      "english": "Okay. / Sure."
    },
    {
      "tagalog": "Okay lang.",
      "english": "It's okay."
    },
    {
      "tagalog": "Oo, sige.",
      "english": "Yes, okay."
    },
    {
      "tagalog": "Hindi, salamat.",
      "english": "No, thank you."
    }
  ],
  "notes": [],
  "practice": {
    "objectives": [
      {
        "id": "answer-yes-no",
        "description": "Answer a simple question with yes or no."
      },
      {
        "id": "accept",
        "description": "Accept a suggestion or request using sige."
      },
      {
        "id": "reassure",
        "description": "Use okay lang in a simple everyday situation."
      },
      {
        "id": "decline-politely",
        "description": "Decline politely using Hindi, salamat."
      }
    ],
    "scenarios": [
      {
        "id": "accept-suggestion",
        "title": "Accepting a suggestion",
        "setup": "Someone suggests a simple activity or asks if something is okay.",
        "learnerGoal": "Respond naturally with yes, no, sige, or okay lang depending on the situation.",
        "targets": [
          "Oo.",
          "Hindi.",
          "Sige.",
          "Okay lang.",
          "Oo, sige."
        ]
      },
      {
        "id": "decline-offer",
        "title": "Declining an offer",
        "setup": "Someone offers you something you do not want.",
        "learnerGoal": "Refuse briefly and politely.",
        "targets": [
          "Hindi, salamat."
        ]
      }
    ]
  }
}
