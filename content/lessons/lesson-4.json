{
  "id": "lesson-4",
  "stage": 1,
  "level": "A0",
  "title": "I Don't Understand",
  "goal": "Tell someone you do not understand and ask them to repeat or slow down.",
  "vocabulary": [
    {
      "tagalog": "intindihin",
      "english": "to understand"
    },
    {
      "tagalog": "ulit",
      "english": "again / repeat"
    },
    {
      "tagalog": "dahan-dahan",
      "english": "slowly"
    },
    {
      "tagalog": "sandali",
      "english": "a moment"
    },
    {
      "tagalog": "ano",
      "english": "what"
    }
  ],
  "patterns": [
    {
      "tagalog": "Hindi ko maintindihan.",
      "english": "I don't understand."
    },
    {
      "tagalog": "Pakiulit.",
      "english": "Please repeat."
    },
    {
      "tagalog": "Dahan-dahan lang.",
      "english": "Slowly, please."
    },
    {
      "tagalog": "Ano?",
      "english": "What?"
    },
    {
      "tagalog": "Sandali lang.",
      "english": "Just a moment."
    },
    {
      "tagalog": "Pakiulit po.",
      "english": "Please repeat. (polite)"
    }
  ],
  "notes": [],
  "practice": {
    "objectives": [
      {
        "id": "say-not-understand",
        "description": "Say that you do not understand."
      },
      {
        "id": "ask-repeat",
        "description": "Ask someone to repeat what they said."
      },
      {
        "id": "ask-slow-down",
        "description": "Ask someone to speak more slowly."
      },
      {
        "id": "ask-for-moment",
        "description": "Ask for a moment when you need time."
      }
    ],
    "scenarios": [
      {
        "id": "fast-speaker",
        "title": "Someone speaks too quickly",
        "setup": "A person says something in Tagalog too quickly for you to follow.",
        "learnerGoal": "Tell them you do not understand and ask them to repeat or slow down.",
        "targets": [
          "Hindi ko maintindihan.",
          "Pakiulit.",
          "Dahan-dahan lang.",
          "Pakiulit po."
        ]
      },
      {
        "id": "need-a-moment",
        "title": "You need a moment",
        "setup": "You are trying to understand or respond but need a few seconds.",
        "learnerGoal": "Ask for a moment and then continue the interaction.",
        "targets": [
          "Sandali lang.",
          "Ano?"
        ]
      }
    ]
  }
}
