{
  "id": "lesson-10",
  "stage": 1,
  "level": "A0",
  "title": "Can I?",
  "goal": "Ask for permission and understand simple permission responses.",
  "vocabulary": [
    {
      "tagalog": "puwede",
      "english": "can / allowed / possible"
    },
    {
      "tagalog": "dito",
      "english": "here"
    },
    {
      "tagalog": "doon",
      "english": "there"
    },
    {
      "tagalog": "umupo",
      "english": "to sit"
    },
    {
      "tagalog": "pumasok",
      "english": "to enter / come in"
    },
    {
      "tagalog": "gumamit",
      "english": "to use"
    }
  ],
  "patterns": [
    {
      "tagalog": "Puwede ba?",
      "english": "Can I? / Is it allowed?"
    },
    {
      "tagalog": "Puwede.",
      "english": "Yes, you can. / It is allowed."
    },
    {
      "tagalog": "Hindi puwede.",
      "english": "You can't. / It is not allowed."
    },
    {
      "tagalog": "Puwede ba akong umupo dito?",
      "english": "Can I sit here?"
    },
    {
      "tagalog": "Puwede ba akong pumasok?",
      "english": "Can I come in?"
    },
    {
      "tagalog": "Puwede ko bang gamitin ito?",
      "english": "Can I use this?"
    }
  ],
  "notes": [],
  "practice": {
    "objectives": [
      {
        "id": "ask-permission",
        "description": "Ask for permission with Puwede ba?"
      },
      {
        "id": "understand-permission",
        "description": "Understand simple allowed and not-allowed responses."
      },
      {
        "id": "ask-sit",
        "description": "Ask whether you may sit somewhere."
      },
      {
        "id": "ask-enter-use",
        "description": "Ask whether you may enter or use something."
      }
    ],
    "scenarios": [
      {
        "id": "ask-seat",
        "title": "Asking to sit",
        "setup": "You see an empty seat and want to know whether you may sit there.",
        "learnerGoal": "Ask permission and understand a simple yes or no response.",
        "targets": [
          "Puwede ba?",
          "Puwede.",
          "Hindi puwede.",
          "Puwede ba akong umupo dito?"
        ]
      },
      {
        "id": "enter-or-use",
        "title": "Entering or using something",
        "setup": "You want to enter a room or use an object.",
        "learnerGoal": "Ask permission with the appropriate sentence.",
        "targets": [
          "Puwede ba akong pumasok?",
          "Puwede ko bang gamitin ito?"
        ]
      }
    ]
  }
}
