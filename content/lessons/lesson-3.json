{
  "id": "lesson-3",
  "stage": 1,
  "level": "A0",
  "title": "Thanks, Sorry, and Goodbye",
  "goal": "Use essential polite expressions in everyday interactions.",
  "vocabulary": [
    {
      "tagalog": "salamat",
      "english": "thank you"
    },
    {
      "tagalog": "po",
      "english": "politeness marker"
    },
    {
      "tagalog": "walang anuman",
      "english": "you're welcome"
    },
    {
      "tagalog": "pasensya na",
      "english": "sorry / excuse me"
    },
    {
      "tagalog": "paalam",
      "english": "goodbye"
    },
    {
      "tagalog": "ingat",
      "english": "take care"
    }
  ],
  "patterns": [
    {
      "tagalog": "Salamat.",
      "english": "Thank you."
    },
    {
      "tagalog": "Salamat po.",
      "english": "Thank you. (polite)"
    },
    {
      "tagalog": "Walang anuman.",
      "english": "You're welcome."
    },
    {
      "tagalog": "Pasensya na.",
      "english": "Sorry. / Excuse me."
    },
    {
      "tagalog": "Paalam.",
      "english": "Goodbye."
    },
    {
      "tagalog": "Ingat.",
      "english": "Take care."
    }
  ],
  "notes": [
    "Use po to sound polite, especially with older people, strangers, or in service situations."
  ],
  "practice": {
    "objectives": [
      {
        "id": "thank",
        "description": "Thank someone in a normal or polite way."
      },
      {
        "id": "respond-to-thanks",
        "description": "Respond when someone thanks you."
      },
      {
        "id": "apologize",
        "description": "Say sorry or excuse me in a simple situation."
      },
      {
        "id": "say-goodbye",
        "description": "End a short interaction with goodbye or take care."
      }
    ],
    "scenarios": [
      {
        "id": "service-interaction",
        "title": "Polite service interaction",
        "setup": "A staff member helps you with something.",
        "learnerGoal": "Thank them politely and respond appropriately if they reply.",
        "targets": [
          "Salamat.",
          "Salamat po.",
          "Walang anuman."
        ]
      },
      {
        "id": "leaving",
        "title": "Ending a conversation",
        "setup": "You are leaving after a short conversation.",
        "learnerGoal": "Say goodbye naturally and use a simple closing expression.",
        "targets": [
          "Paalam.",
          "Ingat.",
          "Pasensya na."
        ]
      }
    ]
  }
}
