{
  "id": "lesson-7",
  "stage": 1,
  "level": "A0",
  "title": "Drinking",
  "goal": "Talk about drinking and basic drink needs.",
  "vocabulary": [
    {
      "tagalog": "uminom",
      "english": "to drink / drank"
    },
    {
      "tagalog": "tubig",
      "english": "water"
    },
    {
      "tagalog": "kape",
      "english": "coffee"
    },
    {
      "tagalog": "tsaa",
      "english": "tea"
    },
    {
      "tagalog": "gatas",
      "english": "milk"
    },
    {
      "tagalog": "mainit",
      "english": "hot"
    },
    {
      "tagalog": "malamig",
      "english": "cold"
    }
  ],
  "patterns": [
    {
      "tagalog": "Uminom ako ng tubig.",
      "english": "I drank water."
    },
    {
      "tagalog": "Uminom ako ng kape.",
      "english": "I drank coffee."
    },
    {
      "tagalog": "Uminom ako ng tsaa.",
      "english": "I drank tea."
    },
    {
      "tagalog": "Uminom ako ng gatas.",
      "english": "I drank milk."
    },
    {
      "tagalog": "Mainit ang kape.",
      "english": "The coffee is hot."
    },
    {
      "tagalog": "Malamig ang tubig.",
      "english": "The water is cold."
    }
  ],
  "notes": [],
  "practice": {
    "objectives": [
      {
        "id": "say-what-drank",
        "description": "Say what you drank using a simple Uminom ako ng ... sentence."
      },
      {
        "id": "use-drink-words",
        "description": "Use basic drink vocabulary in short sentences."
      },
      {
        "id": "describe-temperature",
        "description": "Describe a drink as hot or cold."
      }
    ],
    "scenarios": [
      {
        "id": "drink-chat",
        "title": "Talking about drinks",
        "setup": "Someone asks what you drank.",
        "learnerGoal": "Answer using water, coffee, tea, or milk.",
        "targets": [
          "Uminom ako ng tubig.",
          "Uminom ako ng kape.",
          "Uminom ako ng tsaa.",
          "Uminom ako ng gatas."
        ]
      },
      {
        "id": "temperature",
        "title": "Describing a drink",
        "setup": "You are talking about the temperature of a drink.",
        "learnerGoal": "Say whether the coffee or water is hot or cold.",
        "targets": [
          "Mainit ang kape.",
          "Malamig ang tubig."
        ]
      }
    ]
  }
}
